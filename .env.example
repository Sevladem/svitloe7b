# Telegram bot token
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# JSON array of sensors to probe
# Example: [{"key":"osbb7b_2","address":"93.175.228.129","port":8000}]
PING_LIST=[{"key":"osbb7b_2","address":"93.175.228.129","port":8000}]

# Optional: set to "false" to skip clearing pending updates on startup
# FLUSH_UPDATES_ON_START=false

# Optional: override the schedule image path used by the hidden /shedule command
# SCHEDULE_IMAGE_PATH=./img/shedule.png
